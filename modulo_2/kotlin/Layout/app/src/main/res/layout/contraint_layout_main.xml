<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/tvCenter"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:background="@android:color/background_dark"
        android:text="Nuestro constarirt"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_ToEndOf="parenet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopPf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
    />

    <ImageView
        android:id="@+id/imgPhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopPf="parent"
        android:layout_manginStart="16dp"
        android:layout_manginTop="16dp"

        />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:background="@android:color/background_dark"
        android:text="ES UN LAYOUT"
        android:lines="1"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="20sp"
        app:layout_constraintEnd_ToEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_marginStart="16dp"
        app:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopPf="@id/imgPhoto"
        app:layout_constraintBottom_toBottomOf="@id/imgPhoto"
        />
    <View
        android:id="@+id/vSpace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/holo_blue_bright"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_ToEndOf="parent"
        app:layout_contraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toBottom="@id/tvTitle"
        app:layout_goneMarginTop="16dp"

        />
    <Button
        android:id="@+id/bntOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aceptar"
        app:layout_constraintStart_toStart="@id/vSpace"
        app:layout_constraintEnd_toEndOf="@id/vSpace"
        app:layout_constraintTop_toBottomOf="@id/imgPhoto"
        app:layout_marginTop="16dp"
        />

    <Button
        android:id="@+id/bntTwo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        app:layout_constraintStart_toStart="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bntOne"
        app:layout_marginTop="16dp"
        />
    <Button
        android:id="@+id/bntThree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actualizar"
        app:layout_constraintStart_toStart="@id/bntOne"
        app:layout_constraintEnd_toEndOf="@id/bntOne"
        app:layout_constraintTop_toBottomOf="@id/bntTwo"
        app:layout_marginTop="16dp"
        />

    <ImageView
        android:id="@+id/imgUte"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:src="@drawable/logo"
        android:background="@android:color/holo_blue_bright"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomtOf="@id/tvTitle"
        android:layout_marginBottom="130dp"
        tool:ignore="MissingConstraints"
        />
    <ImageButton
        android:id="@+id/imgMic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="64dp"
        android:src="@android:drawable/ic_btn_speak_now"

        />
    <ImageButton
        android:id="@+id/imgPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/imgUte"
        app:layout_constraintTop_toTopOf="@id/imgUte"
        android:src="@android:drawable/ic_media_play"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id = "@+id/second"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTop="@id/ImgUte">


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percenr="0.5"
            >
        </androidx.constraintlayout.widget.Guideline>
            <ImageView
                android:id="@+id/imgGuide"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:src="@drawable/ute"
                android:layout_margin="8dp"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>