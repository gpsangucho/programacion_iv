🏗️ EJEMPLO DE ESTRUCTURA COMPLETA
<body>
  <header>
    <nav></nav>
  </header>

  <main>
    <section>
      <article>
        <h1>Título</h1>
        <p>Contenido</p>
      </article>
    </section>

    <aside>
      Contenido lateral
    </aside>
  </main>

  <footer>
    © 2026
  </footer>
</body>

